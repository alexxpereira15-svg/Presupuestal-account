generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  INCOME
  FIXED_EXPENSE
  DEBT
  VARIABLE_EXPENSE
  SAVING_INVESTMENT
}

model MonthlyBudget {
  id             String        @id @default(uuid())
  userId         String
  year           Int
  month          Int
  initialBalance Decimal       @default(0.00) @db.Decimal(12, 2)
  currency       String        @default("MXN")
  createdAt      DateTime      @default(now())
  
  items          BudgetItem[]
  transactions   Transaction[]

  @@unique([userId, year, month])
}

model BudgetItem {
  id              String        @id @default(uuid())
  budgetId        String
  budget          MonthlyBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name            String
  type            CategoryType
  estimatedAmount Decimal       @default(0.00) @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())

  transactions    Transaction[]
}

model Transaction {
  id           String        @id @default(uuid())
  budgetId     String
  budget       MonthlyBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetItemId String?
  budgetItem   BudgetItem?   @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  date         DateTime      @default(now())
  amount       Decimal       @db.Decimal(12, 2)
  description  String?
  createdAt    DateTime      @default(now())
}

model GlobalDebt {
  id              String   @id @default(cuid())
  userId          String
  creditorName    String
  totalAmount     Decimal  @db.Decimal(12, 2)
  paidAmount      Decimal  @default(0) @db.Decimal(12, 2)
  monthlyPayment  Decimal  @default(0) @db.Decimal(12, 2) // Pago mensual estimado
  paymentType     String   @default("FIXED")              // "FIXED" o "VARIABLE"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SavingGoal {
  id              String   @id @default(cuid())
  userId          String
  title           String
  targetAmount    Decimal  @db.Decimal(12, 2)
  savedAmount     Decimal  @default(0) @db.Decimal(12, 2)
  periodAmount    Decimal  @default(0) @db.Decimal(12, 2)
  frequency       String   @default("MONTHLY") // "WEEKLY", "FORTNIGHTLY", "MONTHLY"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
